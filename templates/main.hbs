<div class="twl-shell">
  <header class="twl-header">
    <div class="twl-brand"><span class="twl-brand-icon"><i class="fa-solid fa-layer-group" aria-hidden="true"></i></span><div><strong>HoloSuite</strong><span class="twl-kicker">WARDROBE / PRISM</span></div></div>
    {{#if hasActor}}<span class="twl-status-chip {{wardrobeClass}}"><i class="fa-solid fa-circle" aria-hidden="true"></i>{{wardrobeStatus}}</span>{{/if}}
    <label class="twl-theme-field"><span>Tema</span><select data-role="theme-select" aria-label="Tema do Wardrobe"><option value="light" {{#if themeLight}}selected{{/if}}>Claro</option><option value="dark" {{#if themeDark}}selected{{/if}}>Escuro</option></select></label>
  </header>
  <div class="twl-scroll">
    {{#unless hasActor}}
      <section class="twl-empty"><i class="fa-solid fa-user-slash" aria-hidden="true"></i><h2>Nenhum personagem disponível</h2><p>Defina seu Character ou use um Actor do qual você seja Owner.</p></section>
    {{else}}
      <div class="twl-dashboard">
        <section class="twl-library" aria-label="Biblioteca de aparências">
          <header class="twl-character"><span class="twl-avatar" aria-hidden="true">{{actorInitial}}</span><div><h2>{{actor.name}}</h2>{{#if multipleActors}}<select data-role="actor-select" aria-label="Personagem">{{#each actors}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>{{else}}<span>{{galleryCount}} aparências na biblioteca</span>{{/if}}</div>{{#if canSubmitUrl}}<details class="twl-add-panel"><summary><i class="fa-solid fa-plus" aria-hidden="true"></i>Adicionar uma arte</summary><div class="twl-add-content"><label class="twl-field"><span>Link direto da imagem</span><input type="url" data-role="url-input" placeholder="https://…/personagem.webp" autocomplete="off"></label><button type="button" class="twl-primary" data-action="prepareUrl" {{#unless wardrobeReady}}disabled{{/unless}}><i class="fa-solid fa-crop-simple" aria-hidden="true"></i>Abrir no editor</button>{{#if canBrowseFiles}}<button type="button" data-action="pickFile" {{#unless wardrobeReady}}disabled{{/unless}}><i class="fa-solid fa-folder-open" aria-hidden="true"></i>Imagem do Foundry</button>{{/if}}{{#unless wardrobeReady}}<small>{{#if hasToken}}É necessário upload local ou um GM ativo para salvar.{{else}}Escolha um token na cena para preparar a imagem.{{/if}}</small>{{/unless}}</div></details>{{/if}}</header>
          <nav class="twl-collection-tabs" aria-label="Coleções"><button type="button" data-action="filterGallery" data-filter="all" class="{{#if showAll}}is-selected{{/if}}" aria-pressed="{{#if showAll}}true{{else}}false{{/if}}"><i class="fa-solid fa-grip" aria-hidden="true"></i>Todas <span>{{galleryCount}}</span></button><button type="button" data-action="filterGallery" data-filter="favorites" class="{{#if showFavorites}}is-selected{{/if}}" aria-pressed="{{#if showFavorites}}true{{else}}false{{/if}}"><i class="fa-solid fa-star" aria-hidden="true"></i>Favoritas <span>{{favoriteCount}}</span></button></nav>
          <div class="twl-tools"><label class="twl-search"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i><input data-role="search" type="search" value="{{searchQuery}}" placeholder="Buscar aparência…" aria-label="Buscar aparências"></label><select data-role="gallery-sort" aria-label="Ordenar aparências"><option value="favorites" {{#if sortFavorites}}selected{{/if}}>Favoritas primeiro</option><option value="name" {{#if sortName}}selected{{/if}}>Nome A–Z</option></select></div>
          <div class="twl-gallery-scroll" tabindex="0" aria-label="Rolar biblioteca de aparências">
          <section class="twl-grid" aria-label="Aparências disponíveis">
            {{#each gallery}}
              <article class="twl-card {{#if selected}}is-selected{{/if}} {{#if active}}is-active{{/if}}" data-src="{{src}}" data-search="{{searchText}}" style="--twl-motion-index:{{motionIndex}}">
                <button class="twl-image-button" type="button" data-action="selectImage" data-id="{{id}}" aria-label="Pré-visualizar {{name}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}"><img src="{{src}}" alt="" loading="lazy" decoding="async"><span class="twl-active-badge" {{#unless active}}hidden{{/unless}}><i class="fa-solid fa-check" aria-hidden="true"></i>EM USO</span></button>
                {{#if ../canManage}}<button class="twl-favorite-button {{#if favorite}}is-favorite{{/if}}" type="button" data-action="toggleFavorite" data-id="{{id}}" aria-label="{{#if favorite}}Desfavoritar{{else}}Favoritar{{/if}} {{name}}" aria-pressed="{{#if favorite}}true{{else}}false{{/if}}"><i class="fa-solid fa-star" aria-hidden="true"></i></button>{{/if}}
                <div class="twl-card-footer"><strong title="{{name}}">{{name}}</strong><small>{{#if favorite}}Favorita{{else}}Aparência salva{{/if}}</small></div>
              </article>
            {{/each}}
          </section>
          <section class="twl-empty compact" data-role="search-empty" hidden><i class="fa-regular fa-images" aria-hidden="true"></i><h3>Nenhuma aparência encontrada</h3><p>Experimente outra busca, volte a Todas ou adicione uma arte.</p><button type="button" data-action="clearSearch">Limpar filtros</button></section>
          </div>
          <footer class="twl-resultbar"><span data-role="result-count" aria-live="polite"></span><span>Selecione para pré-visualizar</span></footer>
        </section>
        <aside class="twl-inspector" aria-label="Destino e prévia">
          <section class="twl-target"><span class="twl-kicker">APLICAR EM</span><label class="twl-field"><span>Token da cena</span>{{#if multipleTokens}}<select data-role="token-select" aria-label="Token de destino">{{#each tokens}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>{{/each}}</select>{{else}}<strong>{{#if hasToken}}{{tokenName}}{{else}}Nenhum token na cena{{/if}}</strong>{{/if}}</label><div class="twl-token-quickbar"><button type="button" data-role="use-selected-token"><i class="fa-solid fa-crosshairs" aria-hidden="true"></i>Selecionado</button><button type="button" data-role="use-my-token"><i class="fa-solid fa-user" aria-hidden="true"></i>Meu token</button></div>{{#unless hasToken}}<small>Coloque o personagem na cena para aplicar ou preparar uma aparência.</small>{{/unless}}</section>
          {{#if fixedRingSubject}}<div class="twl-inline-warning">A textura fixa do Dynamic Token Ring pode esconder a imagem base.</div>{{/if}}
          {{#if hasSelection}}<section class="twl-preview"><header><span class="twl-kicker">APARÊNCIA SELECIONADA</span></header><div class="twl-preview-stage"><img src="{{selected.src}}" alt="Prévia de {{selected.name}}" decoding="async"><span>512 × 512 / BORDA FIXA</span></div><div class="twl-preview-body"><small data-role="selection-status" aria-live="polite">{{#if selected.active}}Em uso neste token{{else}}Prévia · ainda não aplicada{{/if}}</small><h2>{{selected.name}}</h2><button type="button" class="twl-primary" data-action="switchImage" data-src="{{selected.src}}" {{#unless canApplySelection}}disabled{{/unless}}><i class="fa-solid fa-check" aria-hidden="true"></i><span data-role="apply-label">{{#if selected.active}}Aparência em uso{{else}}Aplicar no token{{/if}}</span></button>{{#if canEditCrop}}<button type="button" data-action="editCrop" data-id="{{selected.id}}" {{#unless wardrobeReady}}disabled{{/unless}}><i class="fa-solid fa-crop-simple" aria-hidden="true"></i>Reenquadrar imagem</button>{{/if}}{{#if canManage}}<div class="twl-preview-actions"><button type="button" data-action="renameImage" data-id="{{selected.id}}"><i class="fa-solid fa-pen" aria-hidden="true"></i>Renomear</button><button type="button" class="twl-danger" data-action="removeImage" data-id="{{selected.id}}"><i class="fa-solid fa-trash" aria-hidden="true"></i>Remover</button></div>{{/if}}</div></section>{{/if}}


        </aside>
      </div>
    {{/unless}}
  </div>
</div>
