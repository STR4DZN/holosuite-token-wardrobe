
<div class="twl-shell">
  <header class="twl-header twl-compact-header">
    <div class="twl-heading">
      <span class="twl-kicker">HOLOSUITE // APARÊNCIAS</span>
      <h1>{{#if actor}}{{actor.name}}{{else}}Aparências{{/if}}</h1>
    </div>

    <span class="twl-status-chip {{wardrobeClass}}">
      <i class="fa-solid fa-circle"></i>
      {{wardrobeStatus}}
    </span>
  </header>

  <div class="twl-scroll">
    {{#unless hasActor}}
      <section class="twl-empty">
        <i class="fa-solid fa-user-slash"></i>
        <h2>Nenhum personagem disponível</h2>
        <p>Defina seu Character ou use um Actor do qual você seja Owner.</p>
      </section>
    {{else}}

      {{#if multipleActors}}
        <label class="twl-field compact">
          <span>Personagem</span>
          <select data-role="actor-select">
            {{#each actors}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
            {{/each}}
          </select>
        </label>
      {{/if}}

      {{#if multipleTokens}}
        <label class="twl-field compact">
          <span>Token</span>
          <select data-role="token-select">
            {{#each tokens}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
            {{/each}}
          </select>
        </label>
      {{/if}}

      <div class="twl-token-quickbar">
        <button type="button" data-role="use-selected-token">
          <i class="fa-solid fa-crosshairs"></i>
          Token selecionado
        </button>
        <button type="button" data-role="use-my-token">
          <i class="fa-solid fa-user"></i>
          Meu token na cena
        </button>
      </div>

      {{#unless hasToken}}
        <section class="twl-empty compact">
          <i class="fa-solid fa-location-crosshairs"></i>
          <h2>Token não encontrado</h2>
          <p>Coloque o personagem na cena atual para trocar sua aparência.</p>
        </section>
      {{else}}
{{#if fixedRingSubject}}
          <div class="twl-inline-warning">
            Dynamic Token Ring possui Subject Texture fixa; ela pode esconder a imagem base.
          </div>
        {{/if}}

        {{#if canSubmitUrl}}
          <section class="twl-add-panel">
            <div class="twl-url-row">
              <input
                type="url"
                data-role="url-input"
                placeholder="Cole o link direto da imagem..."
                autocomplete="off">
              <button type="button" data-action="prepareUrl" {{#unless wardrobeReady}}disabled{{/unless}}>
                <i class="fa-solid fa-crop-simple"></i>
                Preparar
              </button>
            </div>

            {{#if canBrowseFiles}}
              <button class="twl-file-button" type="button" data-action="pickFile" {{#unless wardrobeReady}}disabled{{/unless}}>
                <i class="fa-solid fa-folder-open"></i>
                Escolher imagem do Foundry
              </button>
            {{/if}}

            {{#unless wardrobeReady}}
              <small>O Wardrobe precisa de FILES_UPLOAD local ou de um GM ativo para o relay técnico.</small>
            {{else}}
              {{#if relayUpload}}
                <small>Players usam URL sem acesso aos arquivos. O upload é feito automaticamente por relay técnico.</small>
              {{/if}}
            {{/unless}}
          </section>
        {{/if}}

        <label class="twl-search twl-search-compact">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input data-role="search" type="search" placeholder="Buscar...">
        </label>

        {{#if gallery.length}}
          <section class="twl-grid twl-grid-compact">
            {{#each gallery}}
              <article
                class="twl-card {{#if active}}is-active{{/if}} {{#if favorite}}is-favorite{{/if}}"
                data-search="{{searchText}}">

                <button
                  class="twl-image-button twl-image-button-compact"
                  type="button"
                  data-action="switchImage"
                  data-src="{{src}}"
                  title="Usar {{name}}">
                  <img src="{{src}}" alt="{{name}}" loading="lazy" decoding="async">
                  {{#if active}}<span class="twl-active-badge">ATUAL</span>{{/if}}
                  {{#if favorite}}<span class="twl-star"><i class="fa-solid fa-star"></i></span>{{/if}}
                </button>

                <div class="twl-card-footer">
                  <strong title="{{name}}">{{name}}</strong>

                  {{#if ../canEditCrop}}
                    <div class="twl-card-actions twl-card-actions-compact">
                      <button type="button" data-action="editCrop" data-id="{{id}}" title="Reenquadrar">
                        <i class="fa-solid fa-crop-simple"></i>
                      </button>
                      {{#if ../canManage}}
                        <button type="button" data-action="toggleFavorite" data-id="{{id}}" title="Favoritar">
                          <i class="fa-solid fa-star"></i>
                        </button>
                        <button type="button" data-action="renameImage" data-id="{{id}}" title="Renomear">
                          <i class="fa-solid fa-pen"></i>
                        </button>
                        <button type="button" data-action="removeImage" data-id="{{id}}" title="Remover">
                          <i class="fa-solid fa-trash"></i>
                        </button>
                      {{/if}}
                    </div>
                  {{/if}}
                </div>
              </article>
            {{/each}}
          </section>
        {{else}}
          <section class="twl-empty compact">
            <i class="fa-regular fa-images"></i>
            <h2>Nenhuma aparência</h2>
            <p>Cole uma URL ou escolha uma imagem.</p>
          </section>
        {{/if}}

      {{/unless}}
    {{/unless}}
  </div>
</div>
