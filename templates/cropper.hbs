
<div class="twl-cropper-shell">
  <div class="twl-cropper-scroll">
    <header class="twl-cropper-header">
      <div>
        <span class="twl-kicker">ENQUADRAMENTO MANUAL</span>
        <h2>Arraste, aproxime ou afaste</h2>
        <p>O que ficar fora do círculo será realmente removido.</p>
      </div>
      <span class="twl-tokenizer-chip is-ok">
        <i class="fa-solid fa-circle"></i>
        Mármore Tokenizer 5.0.3
      </span>
    </header>

    <label class="twl-field compact">
      <span>Nome</span>
      <input data-role="crop-name" type="text" value="{{name}}" maxlength="80">
    </label>

    <div class="twl-crop-stage">
      <canvas data-role="crop-canvas" width="512" height="512"></canvas>
      <div class="twl-crop-hint">
        <i class="fa-solid fa-hand"></i>
        Arraste a imagem
      </div>
    </div>

    <div class="twl-zoom-row">
      <i class="fa-solid fa-magnifying-glass-minus"></i>
      <input
        data-role="zoom"
        type="range"
        min="{{zoomMin}}"
        max="{{zoomMax}}"
        step="0.01"
        value="{{zoom}}">
      <i class="fa-solid fa-magnifying-glass-plus"></i>
      <strong data-role="zoom-value">{{zoomPercent}}%</strong>
    </div>

    <section class="twl-frame-color-panel">
      <div class="twl-frame-color-head">
        <div>
          <span class="twl-kicker">COR DA BORDA</span>
          <strong>Textura marmorizada preservada</strong>
        </div>

        <div class="twl-frame-color-inputs">
          <input
            data-role="frame-color"
            type="color"
            value="{{frameColor}}"
            aria-label="Cor da borda">

          <input
            data-role="frame-color-hex"
            type="text"
            value="{{frameColor}}"
            maxlength="7"
            spellcheck="false"
            aria-label="Cor HEX da borda">
        </div>
      </div>

      <div class="twl-color-presets">
        {{#each frameColorPresets}}
          <button
            type="button"
            data-role="frame-preset"
            data-color="{{value}}"
            title="{{label}} — {{value}}"
            style="--twl-preset-color: {{value}};">
            <span></span>
            {{label}}
          </button>
        {{/each}}
      </div>
    </section>

    <div class="twl-source-note">
      <i class="fa-solid fa-link"></i>
      <span title="{{source}}">{{source}}</span>
    </div>
  </div>

  <footer class="twl-cropper-footer">
    <button type="button" data-action="resetCrop" title="Voltar ao enquadramento preenchendo todo o token">
      <i class="fa-solid fa-rotate-left"></i>
      100%
    </button>
    <button type="button" data-action="fitImage" title="Afastar até mostrar a imagem inteira">
      <i class="fa-solid fa-expand"></i>
      Imagem inteira
    </button>
    <span class="twl-spacer"></span>
    <button type="button" data-action="cancelCrop">Cancelar</button>
    <button class="twl-primary" type="button" data-action="saveCrop">
      <i class="fa-solid fa-check"></i>
      Salvar aparência
    </button>
  </footer>
</div>
